---
import Base from '../../layouts/Base.astro';
import BrandGrid from '../../components/BrandGrid.astro';
import { getBrands } from '../../lib/brands';
import { sports, type SportId } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const brands = await getBrands();
  return (Object.keys(sports) as SportId[])
    .map((id) => ({ params: { id }, props: { id, brands: brands.filter((b) => b.data.sports.includes(id)) } }))
    .filter((p) => p.props.brands.length > 0);
}

const { id, brands } = Astro.props;
const name = sports[id];
---
<Base title={`${name}のスポーツブランド`}>
  <h1>{name}</h1>
  <p class="lead">{name}を主な競技とするブランド {brands.length}件</p>
  <BrandGrid brands={brands} />
</Base>
