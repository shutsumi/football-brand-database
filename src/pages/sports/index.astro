---
import Base from '../../layouts/Base.astro';
import { getBrands } from '../../lib/brands';
import { sports } from '../../lib/taxonomy';

const brands = await getBrands();
const rows = Object.entries(sports)
  .map(([id, name]) => ({ id, name, count: brands.filter((b) => (b.data.sports as string[]).includes(id)).length }))
  .filter((r) => r.count > 0);
---
<Base title="競技別一覧">
  <h1>競技別一覧</h1>
  <p class="lead">競技から探す</p>
  <ul class="index-list">
    {rows.map((r) => <li><a href={`/sports/${r.id}/`}><span>{r.name}</span><span class="muted">{r.count}ブランド</span></a></li>)}
  </ul>
</Base>
