---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import { getBrands, byFounded, countryLabel, sportName } from '../../lib/brands';

export async function getStaticPaths() {
  const brands = await getBrands();
  return brands.map((brand) => ({
    params: { id: brand.id },
    // 同じ国のほかのブランド（創業が古い順）
    props: { brand, sameCountry: brands.filter((b) => b.data.country === brand.data.country && b.id !== brand.id).sort(byFounded) },
  }));
}

const { brand, sameCountry } = Astro.props;
const d = brand.data;
const { Content } = await render(brand);
const hasHistory = Boolean(brand.body?.trim());
const group = d.group ? await getEntry(d.group) : undefined;
const updated = `${d.updated.getFullYear()}年${d.updated.getMonth() + 1}月${d.updated.getDate()}日`;
---
<Base
  title={d.nameJa ? `${d.nameEn}（${d.nameJa}）` : d.nameEn}
  description={`${d.nameEn}${d.nameJa ? `（${d.nameJa}）` : ''}は${countryLabel(d.country).split(' ')[1]}のサッカーブランド${d.founded ? `。${d.founded}年創業` : ''}。`}
>
  <div class="detail-logo logo-box">
    <Logo brand={brand} lazy={false} />
  </div>
  <h1>{d.nameEn}</h1>
  {d.nameJa && <p class="lead">{d.nameJa}</p>}

  <dl class="facts">
    <dt>国</dt>
    <dd><a href={`/countries/${d.country}/`}>{countryLabel(d.country)}</a></dd>
    {d.origin && <><dt>創業国</dt><dd><a href={`/countries/${d.origin}/`}>{countryLabel(d.origin)}</a></dd></>}
    <dt>創業</dt>
    <dd>{d.founded ? <a href={`/timeline/`}>{d.founded}年</a> : '不明'}</dd>
    {d.founders.length > 0 && <><dt>創業者</dt><dd>{d.founders.join('、')}</dd></>}
    {group && <><dt>グループ</dt><dd><a href={`/groups/${group.id}/`}>{group.data.nameEn}</a></dd></>}
    {d.officialUrl && (
      <>
        <dt>公式サイト</dt>
        <dd><a href={d.officialUrl} rel="noopener" target="_blank">{d.officialUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd>
      </>
    )}
  </dl>

  {d.nameOrigin && (
    <>
      <h2>名前の由来</h2>
      <p>{d.nameOrigin}</p>
    </>
  )}

  {hasHistory && (
    <>
      <h2>歴史</h2>
      <div class="history"><Content /></div>
    </>
  )}

  {d.sports.length > 1 && (
    <>
      <h2>主な競技</h2>
      <ul class="tags">
        {d.sports.map((s) => <li><span>{sportName(s)}</span></li>)}
      </ul>
    </>
  )}

  {d.athletes.length > 0 && (
    <>
      <h2>主な契約選手</h2>
      <table class="athletes">
        <thead><tr><th>選手</th><th>競技</th><th>国</th></tr></thead>
        <tbody>
          {d.athletes.map((a) => (
            <tr>
              <td><a href={a.source} rel="noopener" target="_blank">{a.name}</a></td>
              <td>{sportName(a.sport)}</td>
              <td>{a.country}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted">選手名のリンクは契約を報じた出典です。契約状況は変わることがあります。</p>
    </>
  )}

  <h2>出典</h2>
  <ul class="sources">
    {d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}
    {d.logo && (
      <li>
        ロゴ：<a href={d.logo.source} rel="noopener" target="_blank">Wikimedia Commons</a>
        （{d.logo.license}{d.logo.author && `／${d.logo.author}`}）
      </li>
    )}
  </ul>
  <p class="muted">情報更新日：{updated}</p>

  {sameCountry.length > 0 && (
    <>
      <h2>{countryLabel(d.country)}のほかのブランド</h2>
      <ul class="chips">
        {sameCountry.map((b) => (
          <li><a href={`/brands/${b.id}/`}>{b.data.founded && <span class="y">{b.data.founded}</span>}{b.data.nameEn}</a></li>
        ))}
      </ul>
    </>
  )}
</Base>
