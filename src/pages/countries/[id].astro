---
import Base from '../../layouts/Base.astro';
import BrandGrid from '../../components/BrandGrid.astro';
import { getBrands } from '../../lib/brands';
import { countries, type CountryId } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const brands = await getBrands();
  return (Object.keys(countries) as CountryId[])
    .map((id) => ({ params: { id }, props: { id, brands: brands.filter((b) => b.data.country === id) } }))
    .filter((p) => p.props.brands.length > 0);
}

const { id, brands } = Astro.props;
const name = countries[id];
---
<Base title={`${name}のスポーツブランド`}>
  <h1>{name}</h1>
  <p class="lead">{name}生まれのスポーツブランド {brands.length}件</p>
  <BrandGrid brands={brands} />
</Base>
