---
import Base from '../../layouts/Base.astro';
import BrandGrid from '../../components/BrandGrid.astro';
import { getBrands, byFounded } from '../../lib/brands';
import { countries, countryIds, flag } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const brands = (await getBrands()).sort(byFounded);
  return countryIds
    .map((id) => ({ params: { id }, props: { id, brands: brands.filter((b) => b.data.country === id) } }))
    .filter((p) => p.props.brands.length > 0);
}

const { id, brands } = Astro.props;
const name = countries[id];
---
<Base title={`${name}のサッカーブランド`} description={`${name}のサッカーブランド${brands.length}件を創業年順に。`}>
  <h1>{flag(id)} {name}</h1>
  <p class="lead">{name}のサッカーブランド {brands.length}件（創業が古い順）</p>
  <BrandGrid brands={brands} />
</Base>
