---
import type { CollectionEntry } from 'astro:content';
import { countryName } from '../lib/brands';

interface Props {
  brands: CollectionEntry<'brands'>[];
}
const { brands } = Astro.props;
---
<ul class="grid" id="brand-grid">
  {brands.map((b) => (
    <li
      data-name={`${b.data.nameEn} ${b.data.nameJa}`.toLowerCase()}
      data-country={b.data.country}
      data-sports={b.data.sports.join(' ')}
    >
      <a class="card" href={`/brands/${b.id}/`}>
        <div class="logo-box">
          <img src={b.data.logo.path} alt={`${b.data.nameEn} のロゴ`} loading="lazy" />
        </div>
        <div class="card-name">{b.data.nameEn}</div>
        <div class="card-meta">{b.data.nameJa}・{countryName(b.data.country)}・{b.data.founded}年</div>
      </a>
    </li>
  ))}
</ul>
