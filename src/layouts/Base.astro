---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'サッカー関連商品を製造・販売している世界のスポーツブランドのデータベース。国・創業年で探せて、大手から無名のブランドまで出典つき。' } = Astro.props;
const siteName = 'サッカーブランドデータベース';
const fullTitle = title ? `${title}｜${siteName}` : siteName;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/"><b>SOCCER BRAND DATABASE</b><span>{siteName}</span></a>
        <nav class="site-nav">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}><b>BRANDS</b><span>すべて</span></a>
          <a href="/countries/" aria-current={path.startsWith('/countries') ? 'page' : undefined}><b>COUNTRIES</b><span>国別</span></a>
          <a href="/timeline/" aria-current={path.startsWith('/timeline') ? 'page' : undefined}><b>TIMELINE</b><span>年表</span></a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="wordmark">SOCCER BRAND DATABASE</p>
        <p>掲載しているロゴ・ブランド名は各社の商標または登録商標です。本サイトは各社と提携・関係するものではありません。</p>
        <p>ロゴ画像は Wikimedia Commons から取得し、国・創業年は主に Wikipedia と Wikidata にもとづきます。いずれも、各ブランドのページに出典を記載しています。掲載情報は記載の更新日時点のものです。</p>
      </div>
    </footer>
  </body>
</html>
